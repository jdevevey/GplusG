def NTT(v, T_zeta):
    n = len(T_zeta)
    q = T_zeta[0]
    T = v.lift().coefficients(sparse=False)
    T += [0]*(n - len(T))
    assert len(T) == n
    m = 0
    length = n // 2
    while length >= 1:
        counter = 0
        while counter < n:
            m += 1
            zeta = T_zeta[m]
            for j in range(counter, counter + length):
                t = (zeta * T[j + length]) % q
                T[j + length] = (T[j] - t) % q
                T[j] = (T[j] + t) % q
            counter += 2*length
        length //= 2
    return T

def invNTT(T, T_zeta, inv):
    n = len(T_zeta)
    q = T_zeta[0]
    V = [x for x in T]
    m = n
    length = 1
    while length < n:
        counter = 0
        while counter < n:
            m -= 1
            zeta = -T_zeta[m]
            for j in range(counter, counter + length):
                v = V[j]
                V[j] = (v + V[j + length])
                V[j + length] = (zeta * (v - V[j + length]))
            counter += 2* length
        length *= 2
    return Rq(inv) * Rq(V)



