from sage.all import *

def FFT(v, n):
    if n not in [256, 512, 1024]:
        return 0
    T = v.lift().coefficients(sparse=False)
    T += [0]*(n - len(T))
    assert len(T) == n
    m = 0
    length = n // 2
    while length >= 1:
        counter = 0
        while counter < n:
            m += 1
            zeta = T_omega[n>>9][m]
            for j in range(counter, counter + length):
                t = (zeta * T[j + length]) 
                T[j + length] = (T[j] - t) 
                T[j] = (T[j] + t)
            counter += 2*length
        length //= 2
    return T

def largest_sv(v, n):
    T = [FFT(p, n) for p in v]
    return max([sum([abs(T[i][j])**2 for i in range(len(T))]) for j in range(len(T[0]))])

